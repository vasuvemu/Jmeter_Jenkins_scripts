                <stringProp name="JSONPostProcessor.jsonPathExprs">$.totalQuantity</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200/201" enabled="true">
                <collectionProp name="Asserion.test_strings"/>
                <collectionProp name="Asserts.test_strings">
                  <stringProp name="1">^20[01]$</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message"></stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">1</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="JSON: products[0].id exists" enabled="true">
                <stringProp name="JSON_PATH">$.products[0].id</stringProp>
                <stringProp name="EXPECTED_VALUE"></stringProp>
                <boolProp name="JSONVALIDATION">false</boolProp>
                <boolProp name="EXPECT_NULL">false</boolProp>
                <boolProp name="INVERT">false</boolProp>
                <boolProp name="ISREGEX">false</boolProp>
              </JSONPathAssertion>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Verify product count echoed" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">// number of nested products echoed by the server must match what we sent
int added = (vars.get(&quot;addedId_matchNr&quot;) ?: &quot;0&quot;) as int
int expected = (vars.get(&quot;selCount&quot;) ?: &quot;0&quot;) as int
if (added != expected) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Expected &quot; + expected + &quot; products in response but got &quot; + added)
}
</stringProp>
              </JSR223Assertion>
              <hashTree/>
              <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion (max RT)" enabled="true">
                <stringProp name="DurationAssertion.duration">${__P(max_rt,5000)}</stringProp>
              </DurationAssertion>
              <hashTree/>
            </hashTree>
