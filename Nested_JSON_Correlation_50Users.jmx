            <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="JSON: carts[0].products[0].id exists">
              <stringProp name="JSON_PATH">$.carts[0].products[0].id</stringProp>
              <stringProp name="EXPECTED_VALUE"></stringProp>
              <boolProp name="JSONVALIDATION">false</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">false</boolProp>
            </JSONPathAssertion>
            <hashTree/>
            <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="JSON: carts array not empty" enabled="true">
              <stringProp name="JSON_PATH">$.carts[*].id</stringProp>
              <stringProp name="EXPECTED_VALUE"></stringProp>
              <boolProp name="JSONVALIDATION">false</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
              <boolProp name="INVERT">false</boolProp>
              <boolProp name="ISREGEX">false</boolProp>
            </JSONPathAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion (max RT)">
              <stringProp name="DurationAssertion.duration">${__P(max_rt,5000)}</stringProp>
            </DurationAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Select random unique product ids">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.util.*
// ---- Nested array correlation: $.carts[*].products[*].id  -&gt;  productId_1..productId_N
int n = (vars.get(&quot;productId_matchNr&quot;) ?: &quot;0&quot;) as int
def ids = new LinkedHashSet()
n.times { ids.add(vars.get(&quot;productId_&quot; + (it + 1))) }
ids.remove(&quot;NOT_FOUND&quot;)

// total quantity across all nested product arrays
int qn = (vars.get(&quot;productQty_matchNr&quot;) ?: &quot;0&quot;) as int
int totalQty = 0
qn.times { totalQty += (vars.get(&quot;productQty_&quot; + (it + 1)) ?: &quot;0&quot;) as int }
vars.put(&quot;allCartsTotalQty&quot;, totalQty.toString())

// pick up to 3 random, unique product ids for the next steps
def list = new ArrayList(ids)
Collections.shuffle(list)
int cnt = Math.min(3, list.size())
cnt.times { vars.put(&quot;sel_&quot; + (it + 1), list[it].toString()) }
vars.put(&quot;selCount&quot;, cnt.toString())
vars.putObject(&quot;cartLines&quot;, new ArrayList())   // reset the cart for this iteration
log.info(&quot;Carts found=&quot; + vars.get(&quot;cartId_matchNr&quot;) + &quot;, nested products=&quot; + n + &quot;, unique=&quot; + ids.size() + &quot;, selected=&quot; + cnt)
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="03_Product_Details_ForEach">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <ForeachController guiclass="ForeachControlPanel" testclass="ForeachController" testname="ForEach selected product id">
            <stringProp name="ForeachController.inputVal">sel</stringProp>
            <stringProp name="ForeachController.returnVal">currentProdId</stringProp>
            <boolProp name="ForeachController.useSeparator">true</boolProp>
            <stringProp name="ForeachController.startIndex">0</stringProp>
            <stringProp name="ForeachController.endIndex">${selCount}</stringProp>
          </ForeachController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /products/${currentProdId}">
              <stringProp name="HTTPSampler.path">/products/${currentProdId}</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="price" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">prodPrice</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.price</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="title" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">prodTitle</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.title</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="category" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">prodCategory</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.category</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="tags[*] (nested array)" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">prodTag</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.tags[*]</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">-1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="reviews[*].rating (nested array)" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">reviewRating</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.reviews[*].rating</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">-1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="reviews[*].reviewerEmail" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">reviewerEmail</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.reviews[*].reviewerEmail</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">-1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="dimensions.width (nested object)" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">dimWidth</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.dimensions.width</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert HTTP 200/201" enabled="true">
                <collectionProp name="Asserion.test_strings"/>
                <collectionProp name="Asserts.test_strings">
                  <stringProp name="1">^20[01]$</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message"></stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">1</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="JSON: id == currentProdId" enabled="true">
                <stringProp name="JSON_PATH">$.id</stringProp>
                <stringProp name="EXPECTED_VALUE">${currentProdId}</stringProp>
                <boolProp name="JSONVALIDATION">true</boolProp>
                <boolProp name="EXPECT_NULL">false</boolProp>
                <boolProp name="INVERT">false</boolProp>
                <boolProp name="ISREGEX">false</boolProp>
              </JSONPathAssertion>
              <hashTree/>
              <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="JSON: reviews exists" enabled="true">
                <stringProp name="JSON_PATH">$.reviews</stringProp>
                <stringProp name="EXPECTED_VALUE"></stringProp>
                <boolProp name="JSONVALIDATION">false</boolProp>
                <boolProp name="EXPECT_NULL">false</boolProp>
                <boolProp name="INVERT">false</boolProp>
                <boolProp name="ISREGEX">false</boolProp>
