              <hashTree/>
              <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion (max RT)" enabled="true">
                <stringProp name="DurationAssertion.duration">${__P(max_rt,5000)}</stringProp>
              </DurationAssertion>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Add cart line + avg rating" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">// build one cart line per product + compute average rating from nested reviews[*].rating
def lines = vars.getObject(&quot;cartLines&quot;)
if (lines == null) { lines = new ArrayList() }
int qty = 1 + new Random().nextInt(3)
lines.add([id: (vars.get(&quot;currentProdId&quot;) as int), quantity: qty])
vars.putObject(&quot;cartLines&quot;, lines)

int rc = (vars.get(&quot;reviewRating_matchNr&quot;) ?: &quot;0&quot;) as int
double sum = 0
rc.times { sum += (vars.get(&quot;reviewRating_&quot; + (it + 1)) as double) }
vars.put(&quot;avgRating&quot;, String.format(&quot;%.2f&quot;, rc &gt; 0 ? sum / rc : 0.0d))
log.info(&quot;Product &quot; + vars.get(&quot;currentProdId&quot;) + &quot; | &quot; + vars.get(&quot;prodTitle&quot;) + &quot; | price=&quot; + vars.get(&quot;prodPrice&quot;)
         + &quot; | tags=&quot; + vars.get(&quot;prodTag_matchNr&quot;) + &quot; | reviews=&quot; + rc + &quot; | avg=&quot; + vars.get(&quot;avgRating&quot;) + &quot; | qty=&quot; + qty)
</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If products were selected" enabled="true">
          <stringProp name="IfController.condition">${__groovy(((vars.get(&apos;selCount&apos;) ?: &apos;0&apos;) as int) &gt; 0)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="04_Add_To_Cart" enabled="true">
            <boolProp name="TransactionController.includeTimers">false</boolProp>
          </TransactionController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /carts/add (dynamic nested body)">
              <stringProp name="HTTPSampler.path">/carts/add</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">${cartBody}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build nested JSON body" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import groovy.json.JsonOutput
// dynamically build nested JSON:  {&quot;userId&quot;:1,&quot;products&quot;:[{&quot;id&quot;:..,&quot;quantity&quot;:..}, ...]}
def lines = vars.getObject(&quot;cartLines&quot;) ?: []
def body = [userId: (vars.get(&quot;userId&quot;) as int), products: lines]
vars.put(&quot;cartBody&quot;, JsonOutput.toJson(body))
log.info(&quot;Cart body = &quot; + vars.get(&quot;cartBody&quot;))
</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="addedId (response nested) $.products[*].id" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">addedId</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.products[*].id</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">-1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
              </JSONPostProcessor>
