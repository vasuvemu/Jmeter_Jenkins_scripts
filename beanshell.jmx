int b = 20;
int sum = a + b;

log.info(&quot;Sum is: &quot; + sum);

/*
for loop
for(int i=0; i&lt;5; i++){
    log.info(&quot;Iteration: &quot; + i);
}

If-Else
int num = 10;

if(num &gt; 5){
    log.info(&quot;Greater than 5&quot;);
}else{
    log.info(&quot;Less or equal to 5&quot;);
}
*/
</stringProp>
